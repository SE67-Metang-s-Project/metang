#!/bin/sh
# Runs the fast CI checks before every push (NAT-231). The team pushes directly to main, so this
# is the only check before code lands there; CI runs the full set after the push.
# `npm install` enables this hook through the `prepare` script. `git push --no-verify` skips it -
# never use that on main.
set -e

echo "pre-push: npm run lint"
npm run lint

echo "pre-push: npx tsc --noEmit"
npx tsc --noEmit
