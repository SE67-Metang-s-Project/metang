{
  "name": "methang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-infisical.mjs next dev -p 8080",
    "dev-normal": "next dev -p 8080",
    "build": "NODE_ENV=production node scripts/with-infisical.mjs next build",
    "start": "next start",
    "lint": "eslint",
    "openapi:generate": "next-openapi-gen generate -t next.openapi.json && node scripts/normalize-openapi.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:status": "node scripts/with-infisical.mjs prisma migrate status",
    "db:migrate": "node scripts/with-infisical.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-infisical.mjs prisma migrate deploy",
    "db:push": "node scripts/with-infisical.mjs prisma db push",
    "db:pull": "node scripts/with-infisical.mjs prisma db pull",
    "db:studio": "node scripts/with-infisical.mjs prisma studio",
    "db:seed": "node scripts/with-infisical.mjs prisma db seed",
    "db:reset": "node scripts/with-infisical.mjs tsx db/seed.ts --reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "next-openapi-gen": "^1.7.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
