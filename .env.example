# Selects the Infisical environment used by `npm run dev` and `npm run db:*`.
INFISICAL_ENV=dev #dev or prod

# Supabase Session pooler for the application (copy from Project > Connect).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct connection for Prisma migrations. Use the Session pooler if direct IPv6 is unavailable.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# CMU ENTRA
EXT_PORT=8080
AUTH_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/authorize
TOKEN_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/token
CALLBACK_URL=http://localhost:8080/api/auth/callback
CLIENT_ID=<application id จากหน้า overview>
CLIENT_SECRET=<secret ที่ copy ไว้>
SESSION_SECRET=<random string อย่างน้อย 32 ตัวอักษร>
SCOPE=api://cmu/Mis.Account.Read.Me.Basicinfo offline_access
BASICINFO_URL=https://api.cmu.ac.th/mis/cmuaccount/prod/v3/me/basicinfo
LOGOUT_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/logout?post_logout_redirect_uri=http://localhost:8080
SESSION_SECRET=random-hash
