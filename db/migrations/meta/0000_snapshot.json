  "views": {
    "public.student_conduct": {
      "name": "student_conduct",
      "schema": "public",
      "columns": {
        "student_id": {
          "name": "student_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "overdue_count": {
          "name": "overdue_count",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "late_payment_count": {
          "name": "late_payment_count",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "max_days_late": {
          "name": "max_days_late",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "is_delinquent": {
          "name": "is_delinquent",
          "type": "boolean",
          "primaryKey": false,
          "notNull": false
        }
      },
      "isExisting": false,
      "definition": "SELECT l.student_id, count(*) FILTER (WHERE i.settled_at IS NULL AND i.due_date < CURRENT_DATE) AS overdue_count, count(*) FILTER (WHERE i.settled_at IS NOT NULL AND i.settled_at::date > i.due_date) AS late_payment_count, COALESCE(max(CURRENT_DATE - i.due_date) FILTER (WHERE i.settled_at IS NULL AND i.due_date < CURRENT_DATE), 0) AS max_days_late, count(*) FILTER (WHERE i.settled_at IS NULL AND i.due_date < CURRENT_DATE) > 0 AS is_delinquent FROM loan_request l JOIN installment i ON i.loan_id = l.id GROUP BY l.student_id",
      "materialized": false
    }
  },
