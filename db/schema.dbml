// metang ER diagram (NAT-8)
// Paste into https://dbdiagram.io/d — mirrors db/schema.prisma.
// db/schema.prisma is the source of truth; update this file when it changes.

Project metang {
  database_type: 'PostgreSQL'
  Note: 'CMU student emergency loan system. Approval chain: advisor > admin > executive > admin disburses.'
}

Enum user_role_name {
  student
  advisor
  admin
  super_admin
  executive
}

Enum loan_status {
  draft                [note: 'student still filling the form']
  returned             [note: 'sent back for edit — distinct from a final rejection']
  pending_advisor      [note: 'NAT-19 step 1']
  pending_admin        [note: 'NAT-19 step 2']
  pending_executive    [note: 'NAT-19 step 3']
  pending_disbursement [note: 'NAT-19 step 4: back to admin to move the money']
  disbursed
  closed
  rejected
  cancelled
}

Enum approval_step {
  advisor
  admin
  executive
}

Enum decision {
  pending
  approved
  returned  [note: 'fix and resubmit']
  rejected  [note: 'final no']
}

Enum fund_transaction_kind {
  top_up
  withdrawal
  credit_adjustment
  debit_adjustment
  disbursement
  repayment
}

Enum payment_status {
  pending_review
  confirmed
  rejected
}

Enum notification_status {
  pending
  processing
  retry
  delivered
  failed
}

Table app_user {
  id           uuid [pk, default: `gen_random_uuid()`]
  email        text [not null, unique]
  cmu_account  text [not null, unique]
  full_name_th text [not null]
  full_name_en text
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    full_name_th [note: 'advisor_name is matched back to a person by name']
  }
  Note: 'One row per staff member, whatever roles they hold. Students have no row: each loan_request carries its borrower. NAT-16 (CMU SSO).'
}

Table user_role {
  user_id    uuid [ref: > app_user.id, not null]
  role       user_role_name [not null]
  granted_by uuid [ref: > app_user.id, note: 'ON DELETE SET NULL']
  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role) [pk]
  }
  Note: 'NAT-52: multi-role per person. Partial unique index on role WHERE role = executive keeps exactly one executive.'
}

Table loan_request {
  id                text [pk, default: `next_loan_request_id()`, note: 'REQYYYYMMDDNNNN, CHECK loan_request_id_format']
  student_code      text [not null, note: 'the borrower; students are not app_user rows']
  student_name_th   text [not null, note: 'copied from the CMU session at submit']
  student_name_en   text
  student_email     text [not null]
  student_phone     text [note: 'typed by the student, not from CMU SSO']
  student_education_level text [note: 'degree code "0"/"1"/"3"/"5" (the fifth digit of student_code); CHECK loan_request_student_education_level_code']
  advisor_id        uuid [ref: > app_user.id, not null]
  amount            integer [not null, note: 'whole baht; what the student asked for']
  approved_amount   integer [note: 'NAT-46: admin may cut it. Installments build from this. Reason goes in loan_approval.comment.']
  student_year      smallint [not null, note: '1-4']
  purpose           text [not null]
  bank_name         text [not null]
  bank_account_no   text [not null]
  bank_account_name text [not null]
  installment_count smallint [not null, note: '1-3 only']
  first_due_date    date [not null, note: '30 days after the submit date (Bangkok date)']
  status            loan_status [not null, default: 'draft']
  submitted_at      timestamptz
  cancelled_at      timestamptz
  disbursed_at      timestamptz
  transfer_confirmed_at timestamptz [note: 'the student confirms receipt; only after disbursed_at (CHECK loan_request_transfer_confirmed_after_disbursement)']
  closed_at         timestamptz
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  assigned_admin_id uuid [ref: > app_user.id, note: 'Admin who sent the request to Executive; preserved on Executive return']

  indexes {
    student_code
    (advisor_id, status)
    (assigned_admin_id, status)
    (status, submitted_at) [note: 'submitted_at DESC']
  }
  Note: 'NAT-24. Partial unique index on student_code WHERE status NOT IN (closed, rejected, cancelled) allows only one open loan per student.'
}

Table loan_approval {
  id         bigserial [pk]
  loan_id    text [ref: > loan_request.id, not null, note: 'ON DELETE CASCADE']
  step       approval_step [not null]
  attempt    smallint [not null, default: 1]
  decision   decision [not null, default: 'pending']
  decided_by uuid [ref: > app_user.id]
  decided_at timestamptz
  comment    text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (loan_id, step, attempt) [unique]
    (loan_id, step) [note: 'partial unique index for pending rows only']
  }
  Note: 'NAT-19: one row per approval step, so decision history survives.'
}

Table installment {
  id          bigserial [pk]
  loan_id     text [ref: > loan_request.id, not null, note: 'ON DELETE CASCADE']
  seq         smallint [not null, note: '1-3']
  due_date    date [not null]
  amount_due  integer [not null]
  amount_paid integer [not null, default: 0]
  settled_at  timestamptz

  indexes {
    (loan_id, seq) [unique]
    due_date [note: 'partial: WHERE settled_at IS NULL']
    loan_id
  }
  Note: 'NAT-29: amount_due is rewritten on remaining rows when a student overpays.'
}

Table payment {
  id             uuid [pk, default: `gen_random_uuid()`]
  loan_id        text [ref: > loan_request.id, not null]
  installment_id bigint [ref: > installment.id]
  amount         integer [not null, note: 'CHECK payment_amount_positive']
  slip_path      text [note: 'object path in the private slip bucket']
  slip_ref       text [unique, note: 'bank transaction ref: same slip cannot be reused']
  status         payment_status [not null, default: 'pending_review']
  confirmed_by   uuid [ref: > app_user.id, note: 'the reviewer; also written for a rejection']
  confirmed_at   timestamptz
  review_note    text [note: 'note of the reviewer; a rejection needs one']
  paid_at        timestamptz
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    loan_id
  }
  Note: 'NAT-31 slip evidence and NAT-33 confirmation status.'
}

Table fund_transaction {
  id           bigserial [pk]
  kind         fund_transaction_kind [not null]
  amount       integer [not null, note: 'CHECK fund_transaction_amount_positive']
  direction    smallint [not null, note: '+1 in, -1 out; CHECK fund_transaction_direction_valid and fund_transaction_kind_direction_pairing']
  loan_id      text [ref: > loan_request.id]
  payment_id   uuid [ref: > payment.id, note: 'the confirmed payment of a repayment row']
  performed_by uuid [ref: > app_user.id, not null]
  slip_path    text [note: "the admin's own transfer slip on disbursement"]
  note         text
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    loan_id
    loan_id [unique, note: 'partial: WHERE kind = disbursement, one disbursement per loan']
    payment_id [unique, note: 'partial: WHERE kind = repayment, one repayment per payment']
  }
  Note: 'NAT-40/46/47. Fund balance = sum(amount * direction). Never a stored column. Append-only: trigger fund_transaction_append_only blocks UPDATE and DELETE; trigger fund_transaction_check_balance stops the balance from going below 0.'
}

Table audit_log {
  id          bigserial [pk]
  actor_id    uuid [note: 'staff actor; no FK, the row outlives a deleted user']
  actor_student_code text [note: 'student actor; CHECK exactly one of actor_id, actor_student_code']
  actor_name  text [note: 'snapshot at insert (trigger): staff full_name_th or the student name']
  actor_role  text [note: 'snapshot at insert (trigger): held roles comma-joined, or student']
  action      text [not null]
  entity_type text [not null]
  entity_id   text [not null]
  before      jsonb
  after       jsonb
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
  }
  Note: 'NAT-49: every admin action, with before/after. Append-only: UPDATE and DELETE are blocked by trigger.'
}

Table notification_outbox {
  id            uuid [pk, default: `gen_random_uuid()`]
  dedupe_key    text [not null, unique]
  event_type    text [not null]
  payload       jsonb [not null]
  status        notification_status [not null, default: 'pending']
  attempt_count integer [not null, default: 0]
  available_at  timestamptz [not null, default: `now()`]
  delivered_at  timestamptz
  last_error    text
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (status, available_at)
  }
  Note: 'NAT-28/NAT-171: durable claim/retry queue for outgoing messages (LINE to reviewers, email for installment reminders). Unique dedupe_key; at most 5 attempts.'
}

Table system_setting {
  id                  smallint [pk, default: 1]
  bank_name           text [not null]
  account_name        text [not null]
  account_number      text [not null]
  contact_location_th text [not null]
  contact_location_en text
  contact_phone       text [not null]
  contact_ext         text
  contact_email       text [not null]
  updated_by_id       uuid [ref: > app_user.id]
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]

  Note: 'NAT-200: system-wide bank + contact display, read by everyone, written by SuperAdmin only. Singleton row, id always 1 (CHECK constraint).'
}

// The database has no views. The repayment conduct of a student (on time or late) is derived in
// the application from installment and payment (lib/repayment-conduct.ts).
